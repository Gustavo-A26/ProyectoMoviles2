<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo base -->
    <style name="AppButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color6</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <!-- Primario -->
    <style name="AppButton.Primary" parent="AppButton">
        <item name="backgroundTint">@color/color3</item>
    </style>

    <!-- Secundario -->
    <style name="AppButton.Secondary" parent="AppButton">
        <item name="backgroundTint">@color/color2</item>
        <item name="android:textColor">@color/color5</item>
        <item name="strokeColor">@color/color3</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="BottomNavigationActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color2</item>
        <item name="itemIconTint">@color/color5</item>
    </style>
</resources>