<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/main"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color1"
    tools:context=".MainActivity"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp"
        >

        <com.google.android.material.card.MaterialCardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardBackgroundColor="@color/color2"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/color2"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/outline_add_home_24"
                    app:tint="@color/color5"
                    />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="30dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name_first"
                android:textSize="45sp"
                android:textColor="@color/color6"
                android:textStyle="bold"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name_second"
                android:textSize="45sp"
                android:textColor="@color/color4"
                android:textStyle="bold"
                />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenLogin"
            style="@style/AppButton.Primary"
            android:text="@string/button_login"

            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenRegister"
            style="@style/AppButton.Secondary"
            android:text="@string/button_register"
            app:rippleColor="@color/color3"
            />

    </LinearLayout>





</LinearLayout>