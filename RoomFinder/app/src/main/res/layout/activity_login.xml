<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color1"
    tools:context=".ui.auth.LoginActivity">

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center_vertical"
        >

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="@string/title_login"
            android:textColor="@color/color5"
            android:textSize="45sp"
            android:textStyle="bold" />

        <!-- EMAIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/label_email"
                android:textColor="@color/color5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/input_rounded"
                android:hint="@string/input_text_email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="@color/color5"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- PASSWORD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/label_password"
                android:textColor="@color/color5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:autofillHints="password"
                android:background="@drawable/input_rounded"
                android:hint="@string/input_text_password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/color5"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- OLVIDÉ CONTRASEÑA -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:text="@string/forgot_password_text"
            android:textColor="@color/color6"
            android:textSize="11sp"
            app:backgroundTint="@color/color1" />

        <!-- BOTÓN LOGIN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLogin"
            style="@style/AppButton.Primary"
            android:text="@string/title_login"


            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRedirectRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:text="@string/not_has_account"
            android:textColor="@color/color6"
            android:textSize="11sp"
            app:backgroundTint="@color/color1"
            />

    </LinearLayout>

</LinearLayout>